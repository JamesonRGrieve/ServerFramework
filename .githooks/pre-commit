#!/usr/bin/env bash
# Pre-commit gate — blocks commit on any regression.
# Install: git config core.hooksPath .githooks
set -euo pipefail

VENV_PYTHON="$(dirname "$(git rev-parse --git-dir)")/.venv/bin/python"
[ -x "$VENV_PYTHON" ] || VENV_PYTHON=python3

echo "[pre-commit] Running test suite..."
"$VENV_PYTHON" -m pytest src/ \
  -q --tb=no 2>&1 | tail -3
if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo "[pre-commit] FAIL: tests did not pass"
  exit 1
fi

echo "[pre-commit] Running ratchet checks..."
"$VENV_PYTHON" scripts/ratchet-check.py
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAIL: ratchet regression detected"
  exit 1
fi

echo "[pre-commit] All checks passed."
