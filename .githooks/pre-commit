#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Pre-commit gate — blocks commit on any regression.
# Install: git config core.hooksPath .githooks
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
VENV_PYTHON="$REPO/.venv/bin/python"
[ -x "$VENV_PYTHON" ] || VENV_PYTHON=python3
# The whole run, kept so a failure can be read after the fact.
SUITE_LOG="$(git rev-parse --absolute-git-dir)/pre-commit-last.log"
# Lines of the suite's own summary echoed when it passes.
SUMMARY_LINES=3

echo "[pre-commit] Running test suite..."
# Every test path pytest.ini names (the package, the SDK, scripts/).
if ! "$VENV_PYTHON" -m pytest -q --tb=short -rfE >"$SUITE_LOG" 2>&1; then
  grep -E "^(FAILED|ERROR) " "$SUITE_LOG" || true
  tail -n "$SUMMARY_LINES" "$SUITE_LOG"
  echo "[pre-commit] FAIL: tests did not pass (full output: $SUITE_LOG)"
  exit 1
fi
tail -n "$SUMMARY_LINES" "$SUITE_LOG"

echo "[pre-commit] Running ratchet checks..."
if ! "$VENV_PYTHON" scripts/ratchet-check.py; then
  echo "[pre-commit] FAIL: ratchet regression detected"
  exit 1
fi

echo "[pre-commit] All checks passed."
